# Скопируйте в .env и заполните значениями из Supabase: Project Settings → API.
# Публичный (anon / publishable) ключ можно использовать в браузере — доступ ограничивают политики RLS.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# НЕ кладите сюда service_role / secret ключ: всё, что начинается с VITE_, попадает в браузер.

# Только для автотестов базы (локальный PostgreSQL, не рабочая база!):
# TEST_DATABASE_URL=postgresql://postgres@localhost:54329/postgres
